# Local development config for the Python service and ingestion script.
# Copy to .env (gitignored) and fill in. Never commit real keys.
#
# Same variable names as the prod Lambda's environment (Infrastructure/app/hosting.tf),
# except that locally the secrets come from here instead of SSM.

# --- AWS (data stores in the dev env) ---
AWS_PROFILE=<admin-profile>
AWS_REGION=eu-west-2
APP_ENV=dev

LOGS_TABLE=climate-chat-dev-logs
RATELIMITS_TABLE=climate-chat-dev-ratelimits
VECTOR_BUCKET=climate-chat-dev-vectors
CACHE_INDEX=response-cache
SOURCES_INDEX=sources

# --- Secrets (local only) ---
# OpenRouter "dev" key, with a credit cap. The same value goes in
# /climate-chat/dev/openrouter-api-key via Infrastructure/secrets.local.env.
OPENROUTER_API_KEY=<openrouter-dev-key>

# OpenRouter "ingest" key, for the ingestion script.
INGEST_OPENROUTER_API_KEY=<openrouter-ingest-key>

# Cloudflare's published Turnstile test secret: every token passes. Works on localhost
# with the matching test site key 1x00000000000000000000AA. Use the real secret only in prod.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# --- Models (match Infrastructure/app/envs/*.tfvars) ---
MODEL_CLASSIFY=anthropic/claude-haiku-5.5
MODEL_FACTS=anthropic/claude-haiku-5.5
MODEL_REPLY=anthropic/claude-haiku-5.5
MODEL_FALLBACK=openai/gpt-6-luna
MODEL_EMBEDDING=openai/text-embedding-3-small
EMBEDDING_DIMENSION=1536

# --- Limits ---
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_PER_DAY=100
MAX_COMMENT_CHARS=1000
LOG_TTL_DAYS=90
