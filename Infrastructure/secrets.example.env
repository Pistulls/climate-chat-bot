# Values for the SSM SecureString parameters created by Infrastructure/bootstrap.
# Copy to secrets.local.env (gitignored), fill in, then run:
#   Infrastructure/scripts/put-secrets.sh
# Lines left as <...> or empty are skipped, so you can set them one at a time.

# /climate-chat/prod/openrouter-api-key: OpenRouter "prod" key (credit cap e.g. $5)
PROD_OPENROUTER_API_KEY=<openrouter-prod-key>

# /climate-chat/prod/turnstile-secret-key: the real Turnstile widget's secret key
PROD_TURNSTILE_SECRET_KEY=<turnstile-secret-key>

# /climate-chat/dev/openrouter-api-key: OpenRouter "dev" key (credit cap e.g. $2), same as .env
DEV_OPENROUTER_API_KEY=<openrouter-dev-key>

# /climate-chat/ingest/openrouter-api-key: OpenRouter "ingest" key (credit cap e.g. $1)
INGEST_OPENROUTER_API_KEY=<openrouter-ingest-key>

# /climate-chat/{prod,dev}/log-hash-key: HMAC keys for hashed user ids in the request logs.
# Any long random string, a different one each: `openssl rand -hex 32`. Changing one later
# only stops ids linking across the change. The dev value can be the LOG_HASH_KEY in .env.
PROD_LOG_HASH_KEY=<log-hash-key-prod>
DEV_LOG_HASH_KEY=<log-hash-key-dev>
